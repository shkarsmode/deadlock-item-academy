{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js", "/icons/**"]
      }
    },
    {
      "name": "data",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/data/game/meta.json", "/data/game/items.json", "/data/game/heroes.json", "/data/content/bundle.json"]
      }
    },
    {
      "name": "game-art",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/game/**", "/media/**", "/*.woff2"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "cdn-art",
      "urls": ["https://assets-bucket.deadlock-api.com/**"],
      "cacheConfig": { "strategy": "performance", "maxSize": 300, "maxAge": "30d" }
    },
    {
      "name": "api",
      "urls": ["https://api.deadlock-api.com/**"],
      "cacheConfig": { "strategy": "freshness", "maxSize": 20, "maxAge": "1d", "timeout": "8s" }
    }
  ],
  "navigationUrls": ["/**", "!/**/*.*", "!/**/*__*", "!/**/*__*/**"]
}
